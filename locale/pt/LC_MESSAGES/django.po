# AFC translations for the Sign in with AFC screens.
# Hand-authored: the GNU gettext tools are not installed on the build machine,
# and the project's DeepL quota is exhausted.
#
msgid ""
msgstr ""
"Project-Id-Version: AFC\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: pt\n"
